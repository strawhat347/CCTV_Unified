# CCTV Unified Surveillance MVP - Environment Configuration Example
MODE=mock
API_PORT=8002
API_KEY=your_generated_api_key_here
USE_GPU=true

# Database Credentials (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cctv_unified
DB_USER=root
DB_PASS=
DB_POOL_SIZE=15

# Sentinel Camera Grid API
SENTINEL_API_HOST=https://live.corp8.cloud
SENTINEL_API_KEY=

# Processing
OCR_WORKER_COUNT=5

# Model Paths (leave blank to use defaults)
YOLO_MODEL_PATH=
VEHICLE_MODEL_PATH=
VEHICLE_CLASSES=2,3,5,7
VEHICLE_PADDING=0.2
USE_HIERARCHICAL=true

# Tiled Inference
TILE_SIZE=1280
TILE_OVERLAP=0.2
TILE_IOU_THRESHOLD=0.5

# Data Paths
MOCK_VIDEO_DIR=
SEED_REGISTRY_CSV=
TEST_IMAGES_DIR=

# Streaming Config
MJPEG_FPS=15
MJPEG_QUALITY=70
HLS_SEGMENT_TIME=2
HLS_LIST_SIZE=5
STREAM_IDLE_TIMEOUT=30
MAX_CONCURRENT_STREAMS=100

# AI Copilot Config
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.1
OLLAMA_TIMEOUT=120
